---
import '../styles/global.css';
import '../styles/terminal.css';
import { ClientRouter } from 'astro:transitions';
import { challenges } from '../lib/challenges';
import { site, studio, nav, drawerNav, drawerHome, type DrawerGroup, type DrawerItem } from '../lib/site';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${site.name} · learn Termux, the command line and cybersecurity`,
  description = site.description,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const fullTitle = title.includes(site.name) ? title : `${title} · ${site.name}`;
const total = challenges.length;
const isExternal = (href: string) => /^https?:/.test(href);

// Two different questions, answered two different ways.
//
// `isHere` is a prefix test: it decides which category and which sub-page start
// open, so the trail to where you are is already unfolded when the menu opens.
const isHere = (href: string) => {
  if (isExternal(href)) return false;
  const full = base + href;
  if (href === '') return path === base || path === base.slice(0, -1);
  return path === full || path.startsWith(full);
};

// `isCurrent` decides which single entry is marked. A parent that has children
// is only marked when none of its children is the better match, so you never
// see two green entries for one page.
const childMatches = (item: DrawerItem) => (item.children ?? []).some((c) => isHere(c.href));
const isCurrent = (item: DrawerItem) =>
  item.children && item.children.length > 0 ? isHere(item.href) && !childMatches(item) : isHere(item.href);
const groupHasCurrent = (group: DrawerGroup) =>
  group.items.some((i) => isHere(i.href) || childMatches(i));
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1c1b27" />
    <meta name="color-scheme" content="light" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Poppins:wght@500;600;700&display=swap"
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <ClientRouter />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="bar">
        <button
          class="menu-toggle"
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="site-menu"
          aria-label="Open menu"
        >
          <span class="bar-line" aria-hidden="true"></span>
          <span class="bar-line" aria-hidden="true"></span>
          <span class="bar-line" aria-hidden="true"></span>
        </button>

        <a class="brand" href={base} aria-label={`${site.name} home`}>
          <svg class="mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2" y="3.5" width="20" height="17" rx="3.5" stroke="#20d65a" stroke-width="1.8"></rect>
            <path d="M6.6 10.2l2.6 2.1-2.6 2.1" stroke="#20d65a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M11.8 14.6h5.2" stroke="#eef1f5" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          <span>Lear<span class="accent">mux</span></span>
        </a>

        <nav class="header-nav" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={base + item.href}
              class={item.cta ? 'cta' : undefined}
              aria-current={path.includes('/' + item.href.replace(/\/$/, '')) ? 'page' : undefined}
            >{item.label}</a>
          ))}
        </nav>

        <a class="header-search" href={`${base}search/`} aria-label="Search tutorials">
          <Icon name="search" size={19} />
          <span>Search</span>
        </a>
      </div>
    </header>

    {/* A tap has to acknowledge itself. On a slow connection the new page can
        take a moment, and without this the tap looks like it did nothing. */}
    <div class="nav-progress" data-nav-progress data-active="false" data-done="false" aria-hidden="true"></div>

    <div class="drawer-scrim" data-drawer-scrim aria-hidden="true"></div>

    <div class="drawer" id="site-menu" data-drawer data-open="false" role="dialog" aria-modal="true" aria-label="Site menu">
      <div class="drawer__top">
        <a class="brand" href={base}>
          <svg class="mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2" y="3.5" width="20" height="17" rx="3.5" stroke="#20d65a" stroke-width="1.8"></rect>
            <path d="M6.6 10.2l2.6 2.1-2.6 2.1" stroke="#20d65a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M11.8 14.6h5.2" stroke="#eef1f5" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          <span>Lear<span class="accent">mux</span></span>
        </a>
        <button class="drawer__close" type="button" data-drawer-close aria-label="Close menu">
          <Icon name="close" size={20} />
        </button>
      </div>

      <nav aria-label="Menu">
        <a
          class="drawer__link drawer__link--home"
          href={base}
          {...(isCurrent(drawerHome) ? { 'aria-current': 'page' } : {})}
        >
          <span>{drawerHome.label}</span>
        </a>

        {drawerNav.map((group) => {
          const gid = `drawer-group-${slugify(group.title)}`;
          const gOpen = groupHasCurrent(group);
          return (
            <div class="drawer__group">
              <button
                class="drawer__cat"
                type="button"
                data-cat
                aria-expanded={gOpen ? 'true' : 'false'}
                aria-controls={gid}
              >
                <span>{group.title}</span>
                <span class="drawer__chev" aria-hidden="true"><Icon name="chevron" size={15} /></span>
              </button>

              <div class="drawer__panel" id={gid} hidden={!gOpen}>
                {group.items.map((item) => {
                  if (!item.children || item.children.length === 0) {
                    return (
                      <a
                        class="drawer__link"
                        href={isExternal(item.href) ? item.href : base + item.href}
                        {...(isExternal(item.href) ? { target: '_blank', rel: 'noopener' } : {})}
                        {...(isCurrent(item) ? { 'aria-current': 'page' } : {})}
                      >
                        <span>{item.label}</span>
                        {item.tag && <span class="tag">{item.tag}</span>}
                      </a>
                    );
                  }

                  const sid = `drawer-sub-${slugify(item.label)}`;
                  const sOpen = childMatches(item);
                  return (
                    <div class="drawer__item">
                      <div class="drawer__row">
                        <a
                          class="drawer__link"
                          href={base + item.href}
                          {...(isCurrent(item) ? { 'aria-current': 'page' } : {})}
                        >
                          <span>{item.label}</span>
                          {item.tag && <span class="tag">{item.tag}</span>}
                        </a>
                        <button
                          class="drawer__toggle"
                          type="button"
                          data-toggle
                          aria-expanded={sOpen ? 'true' : 'false'}
                          aria-controls={sid}
                          aria-label={`Show the pages in ${item.label}`}
                        >
                          <span class="drawer__chev" aria-hidden="true"><Icon name="chevron" size={15} /></span>
                        </button>
                      </div>
                      <div class="drawer__panel drawer__panel--sub" id={sid} hidden={!sOpen}>
                        {item.children.map((child) => (
                          <a
                            class="drawer__link drawer__link--sub"
                            href={base + child.href}
                            {...(isHere(child.href) ? { 'aria-current': 'page' } : {})}
                          >
                            <span>{child.label}</span>
                          </a>
                        ))}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}
      </nav>

      <div class="drawer__foot">
        <p data-drawer-progress data-total={total}>0 of {total} flags captured</p>
        <a class="btn btn--green btn--block" href={`${base}challenges/`}>Play the CTF</a>
      </div>
    </div>

    <main class="site-main" id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <a class="brand" href={base}>
              <svg class="mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="3.5" width="20" height="17" rx="3.5" stroke="#20d65a" stroke-width="1.8"></rect>
                <path d="M6.6 10.2l2.6 2.1-2.6 2.1" stroke="#20d65a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M11.8 14.6h5.2" stroke="#eef1f5" stroke-width="1.8" stroke-linecap="round"></path>
              </svg>
              <span>Lear<span class="accent">mux</span></span>
            </a>
            <p>{site.tagline}</p>
            <a class="footer-repo" href={site.repository} target="_blank" rel="noopener">
              <Icon name="github" size={16} /> Source on GitHub
            </a>
          </div>

          <div class="footer-col">
            <h4>Tutorials</h4>
            <a href={`${base}course/`}>The course</a>
            <a href={`${base}categories/`}>Categories</a>
            <a href={`${base}learn/getting-started/`}>Getting started</a>
            <a href={`${base}search/`}>Search</a>
          </div>

          <div class="footer-col">
            <h4>CTF &amp; site</h4>
            <a href={`${base}challenges/`}>Play the CTF</a>
            <a href={`${base}about/`}>About us</a>
            <a href={`${base}contact/`}>Contact us</a>
            <a href={`${base}privacy/`}>Privacy policy</a>
          </div>
        </div>

        <div class="footer-base">
          <span>© {new Date().getFullYear()} {site.name}. Released under the MIT licence.</span>
          <a class="studio" href={studio.url} target="_blank" rel="noopener">
            <span>Developed by</span>
            <img class="studio__mark" src={`${base}brand/apsides-labs-light.svg`} height="19" alt={studio.name} />
          </a>
        </div>
      </div>
    </footer>

    <script>
      import { solvedSlugs } from '../lib/progress';

      function refreshProgress() {
        const solved = new Set(solvedSlugs());
        document.querySelectorAll('[data-challenge-slug]').forEach((elm) => {
          const slug = elm.getAttribute('data-challenge-slug');
          elm.classList.toggle('is-solved', slug ? solved.has(slug) : false);
        });
        const total = document.body.dataset.totalChallenges;
        document.querySelectorAll('[data-progress-chip]').forEach((el) => {
          const t = el.getAttribute('data-total') || total || '0';
          el.textContent = `${solved.size} / ${t} captured`;
        });
        document.querySelectorAll('[data-drawer-progress]').forEach((el) => {
          el.textContent = `${solved.size} of ${el.getAttribute('data-total')} flags captured`;
        });
        document.querySelectorAll('[data-progress-bar]').forEach((el) => {
          const t = Number(el.getAttribute('data-total')) || 1;
          (el as HTMLElement).style.width = `${Math.round((solved.size / t) * 100)}%`;
        });
      }

      function initMenu() {
        const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
        const drawer = document.querySelector<HTMLElement>('[data-drawer]');
        const scrim = document.querySelector<HTMLElement>('[data-drawer-scrim]');
        const closeBtn = document.querySelector<HTMLButtonElement>('[data-drawer-close]');
        if (!toggle || !drawer || !scrim || toggle.dataset.bound) return;
        toggle.dataset.bound = '1';

        const focusables = () =>
          Array.from(drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

        const open = () => {
          drawer.dataset.open = 'true';
          toggle.setAttribute('aria-expanded', 'true');
          toggle.setAttribute('aria-label', 'Close menu');
          document.body.classList.add('menu-open');
          window.requestAnimationFrame(() => focusables()[0]?.focus());
        };
        const close = (returnFocus = true) => {
          drawer.dataset.open = 'false';
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open menu');
          document.body.classList.remove('menu-open');
          if (returnFocus) toggle.focus();
        };

        toggle.addEventListener('click', () =>
          toggle.getAttribute('aria-expanded') === 'true' ? close() : open()
        );
        closeBtn?.addEventListener('click', () => close());
        scrim.addEventListener('click', () => close());
        drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close(false)));

        document.addEventListener('keydown', (e) => {
          if (toggle.getAttribute('aria-expanded') !== 'true') return;
          if (e.key === 'Escape') {
            close();
          } else if (e.key === 'Tab') {
            const f = focusables();
            if (!f.length) return;
            const first = f[0];
            const last = f[f.length - 1];
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        });
      }

      // Categories and sub-pages start closed, except the trail to the page you
      // are on, which is already open so you can see where you are.
      function initDrawerGroups() {
        const drawer = document.querySelector<HTMLElement>('[data-drawer]');
        if (!drawer || drawer.dataset.groupsBound) return;
        drawer.dataset.groupsBound = '1';

        drawer.querySelectorAll<HTMLButtonElement>('[data-cat], [data-toggle]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const id = btn.getAttribute('aria-controls');
            const panel = id ? document.getElementById(id) : null;
            const open = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', open ? 'false' : 'true');
            if (panel) panel.hidden = open;
          });
        });
      }

      // Astro fires these around a view transition, so the bar tracks the real
      // navigation rather than a guess at it.
      function initProgressBar() {
        const bar = document.querySelector<HTMLElement>('[data-nav-progress]');
        if (!bar || bar.dataset.bound) return;
        bar.dataset.bound = '1';

        const start = () => {
          bar.dataset.done = 'false';
          bar.dataset.active = 'true';
        };
        const finish = () => {
          if (bar.dataset.active !== 'true') return;
          bar.dataset.active = 'false';
          bar.dataset.done = 'true';
          window.setTimeout(() => {
            bar.dataset.done = 'false';
          }, 420);
        };

        document.addEventListener('astro:before-preparation', start);
        document.addEventListener('astro:after-swap', finish);
        document.addEventListener('astro:page-load', finish);
      }

      function boot() {
        document.body.classList.remove('menu-open');
        document.querySelectorAll('[data-drawer]').forEach((d) => d.setAttribute('data-open', 'false'));
        document.querySelectorAll('[data-menu-toggle]').forEach((t) => {
          t.setAttribute('aria-expanded', 'false');
          t.setAttribute('aria-label', 'Open menu');
        });
        initMenu();
        initDrawerGroups();
        initProgressBar();
        refreshProgress();
      }

      boot();
      document.addEventListener('astro:page-load', boot);
      window.addEventListener('Learmux:progress', refreshProgress);
    </script>
  </body>
</html>
