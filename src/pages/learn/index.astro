---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorials')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)
);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
---

<BaseLayout
  title="Tutorials"
  description="Bite-sized, beginner-friendly tutorials on Termux, the Linux command line, permissions, networking, encoding and shell scripting."
>
  <div class="wrap">
    <div class="section-head" style="margin-top:0.5rem">
      <div>
        <h1>Tutorials</h1>
        <p>{tutorials.length} lessons that pair with the challenges. Read, then go break something.</p>
      </div>
      <a class="btn btn--primary" href={`${base}challenges/`}>Practise in the terminal →</a>
    </div>

    <div class="grid cols-2">
      {tutorials.map((t) => (
        <a class="card card--link" href={`${base}learn/${t.id}/`}>
          <div class="challenge-head">
            <span class="pill">{t.data.level}</span>
            {t.data.tags.slice(0, 3).map((tag) => <span class="pill">{tag}</span>)}
          </div>
          <h3>{t.data.title}</h3>
          <p class="muted">{t.data.description}</p>
          <div class="card-foot"><span class="mono">learn/{t.id}</span></div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
