---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { allTutorials, trackOf } from '../../lib/tutorials';
import { tracks } from '../../lib/curriculum';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const lessons = await allTutorials();
const trackOfId = (id: string) => tracks.find((t) => t.id === id);
---

<BaseLayout
  title="All lessons"
  description="Every lesson in the Learmux course, in order."
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={base}>Home</a><span class="sep">›</span><a href={`${base}course/`}>Course</a><span class="sep">›</span><span>All lessons</span>
    </nav>

    <header class="section--tight">
      <h1>All lessons</h1>
      <p class="lede">
        {lessons.length} lessons in reading order. The course page groups them into tracks, which is the
        better way to work through them.
      </p>
      <div class="actions" style="margin-top:1rem">
        <a class="btn btn--green" href={`${base}course/`}>View the course</a>
      </div>
    </header>

    <ol class="lesson-list">
      {lessons.map((l, i) => {
        const track = trackOfId(l.data.track);
        return (
          <li>
            <a class="lesson-item" href={`${base}learn/${l.id}/`}>
              <span class="lesson-item__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="lesson-item__body">
                <span class="lesson-item__title">{l.data.title}</span>
                <span class="lesson-item__excerpt">{l.data.excerpt}</span>
                <span class="lesson-item__meta">
                  {track ? `Track ${track.number} · ${track.title}` : l.data.category} · {l.data.level}
                </span>
              </span>
              <Icon name="chevron" size={16} />
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</BaseLayout>
