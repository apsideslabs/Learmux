---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { allTutorials, categoryGroups } from '../../lib/tutorials';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const tutorials = await allTutorials();
const groups = await categoryGroups();
---

<BaseLayout
  title="Course"
  description="Short, plain-language lessons on Termux, the Linux command line, permissions, networking, encoding and shell scripting."
>
  <div class="wrap">
    <header class="section">
      <h1>Course</h1>
      <p class="lede">
        {tutorials.length} short lessons that pair with the challenges. Read one, then go and use it.
      </p>
      <div class="chip-row" style="margin-top:1rem">
        {groups.map((g) => (
          <a class="chip" href={`${base}category/${g.slug}/`}>{g.name} · {g.items.length}</a>
        ))}
      </div>
    </header>

    <section>
      <div class="section-label"><span>All lessons</span></div>
      <div class="cards cards--3">
        {tutorials.map((t) => <ArticleCard entry={t} />)}
      </div>
    </section>

    <section class="section--tight">
      <div class="soft-panel" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem">
        <p class="mb-0 muted">Reading is good. Doing is better — the challenges are where it sticks.</p>
        <a class="btn btn--green" href={`${base}challenges/`}>Play the CTF</a>
      </div>
    </section>
  </div>
</BaseLayout>
