---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';
import { allTutorials, categorySlug, formatDate } from '../../lib/tutorials';

export async function getStaticPaths() {
  const tutorials = await getCollection('tutorials');
  return tutorials.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, category, author, date, level, tags } = entry.data;

const all = await allTutorials();
const related = all
  .filter((t) => t.id !== entry.id && t.data.category === category)
  .slice(0, 3);
const fill = related.length ? related : all.filter((t) => t.id !== entry.id).slice(0, 3);
---

<BaseLayout title={title} description={description}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={base}>Home</a>
      <span class="sep">›</span>
      <a href={`${base}category/${categorySlug(category)}/`}>{category}</a>
      <span class="sep">›</span>
      <span>{title}</span>
    </nav>

    <article>
      <header class="article-head">
        <h1>{title}</h1>
        <div class="byline">
          <span class="who"><Icon name="user" size={15} />{author}</span>
          <span class="when"><Icon name="calendar" size={15} />{formatDate(date)}</span>
          <span class="chip chip--easy">{level}</span>
        </div>
      </header>

      <hr class="rule" style="margin:0 0 1.6rem" />

      <div class="prose">
        <Content />
      </div>
    </article>

    <section class="related">
      <div class="section-label"><span>Related articles</span></div>
      <div class="cards cards--3">
        {fill.map((t) => <ArticleCard entry={t} />)}
      </div>
    </section>

    <div class="actions" style="margin-top:2rem">
      <a class="btn btn--outline" href={`${base}learn/`}>All lessons</a>
      <a class="btn btn--green" href={`${base}challenges/`}>Practise in the CTF</a>
    </div>
  </div>
</BaseLayout>
