---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/practice.css';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { findSet } from '../../data/practice';
import { getCollection, render } from 'astro:content';
import { allTutorials, categorySlug, neighbours, positionInTrack, trackOf } from '../../lib/tutorials';

export async function getStaticPaths() {
  const tutorials = await getCollection('tutorials');
  return tutorials.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, category, level, tags } = entry.data;

const track = trackOf(entry);
const pos = await positionInTrack(entry);
const { prev, next } = await neighbours(entry);

// Some lessons have a practice set. The slug of the set is the lesson id, so
// there is no second mapping to keep in step.
const practiceSet = findSet(entry.id);

// Built here rather than in the markup, so the commas and spaces land where
// they should instead of wherever the newlines happen to fall.
const practiceLine = practiceSet
  ? [
      `${practiceSet.questions.length} question${practiceSet.questions.length === 1 ? '' : 's'}`,
      practiceSet.tasks.length > 0
        ? `${practiceSet.tasks.length} task${practiceSet.tasks.length === 1 ? '' : 's'} where you run a real command`
        : null,
    ]
      .filter(Boolean)
      .join(' and ') + ', with the reasoning explained either way.'
  : '';

// Related: the rest of this track, minus the current lesson.
const all = await allTutorials();
const related = all.filter((l) => l.data.track === entry.data.track && l.id !== entry.id).slice(0, 3);
---

<BaseLayout title={title} description={description} image={`/og/${entry.id}.png`}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={base}>Home</a><span class="sep">›</span>
      <a href={`${base}course/`}>Course</a><span class="sep">›</span>
      {track && <><a href={`${base}course/${track.id}/`}>{track.title}</a><span class="sep">›</span></>}
      <span>{title}</span>
    </nav>

    <article>
      <header class="article-head">
        {track && (
          <p class="eyebrow">
            Track {track.number} · Lesson {pos.index} of {pos.total}
          </p>
        )}
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <div class="byline">
          <span class="chip">{category}</span>
          <span class="chip chip--mono">{level}</span>
        </div>
      </header>

      <hr class="rule" />

      <div class="prose">
        <Content />
      </div>

      {practiceSet && (
        <div class="practice-cta">
          <div class="practice-cta__body">
            <h2>Test yourself on this</h2>
            <p>{practiceLine}</p>
          </div>
          <a class="btn btn--green" href={`${base}practice/${practiceSet.slug}/`}>Start</a>
        </div>
      )}

      <nav class="pager" aria-label="Lesson navigation">
        {prev
          ? <a class="pager__link" href={`${base}learn/${prev.id}/`}>
              <span class="pager__dir">Previous</span>
              <span class="pager__title">← {prev.data.title}</span>
            </a>
          : <span class="pager__empty"></span>}
        {next
          ? <a class="pager__link pager__link--next" href={`${base}learn/${next.id}/`}>
              <span class="pager__dir">Next</span>
              <span class="pager__title">{next.data.title} →</span>
            </a>
          : <span class="pager__empty"></span>}
      </nav>
    </article>

    {related.length > 0 && (
      <section class="section--tight">
        <div class="section-label"><span>More in {track ? track.title : category}</span></div>
        <div class="cards cards--3">
          {related.map((r) => <ArticleCard entry={r} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
