---
import BaseLayout from '../layouts/BaseLayout.astro';
import { challenges, categories, totalPoints } from '../lib/challenges';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const cats = categories();
---

<BaseLayout
  title="About us"
  description="What Learmux is, how the sandbox works, and how the site is built."
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={base}>Home</a><span class="sep">›</span><span>About us</span>
    </nav>

    <header style="margin-bottom:1.4rem">
      <h1>About us</h1>
      <p class="lede">
        Learmux is a small publication for learning Termux — Android's terminal and Linux environment —
        and the command line in general.
      </p>
    </header>

    <div class="prose">
      <h2>What this is</h2>
      <p>
        Most command-line tutorials stop at listing commands. Learmux pairs a short written lesson with a
        challenge that makes you use it. You read about <code>grep</code>, then you pull a flag out of a
        noisy log with it.
      </p>
      <p>
        Everything is designed for a phone first, because that is where Termux lives. It works just as well
        on a laptop.
      </p>

      <h2>How the sandbox works</h2>
      <p>
        There is no operating system behind the terminal, and nothing you type ever reaches a real shell.
        Each challenge declares a virtual filesystem, and your keystrokes are parsed by an explicit
        tokeniser and pipeline executor. The same command always produces the same result, and resetting a
        challenge restores the original files.
      </p>
      <p>
        Commands that would normally touch a network or the device — <code>nmap</code>, <code>curl</code>,
        <code>pkg</code>, <code>ps</code> — return output written for that challenge, so nothing depends on
        a server.
      </p>

      <h2>How challenges are validated</h2>
      <p>
        Completing a challenge is decided by explicit rules stored with the challenge, not by scanning for a
        flag string. A rule might require that you read a particular file, run a particular command, or move
        into a particular directory. Submitting the flag directly also works.
      </p>

      <h2>How it is built</h2>
      <ul>
        <li><strong>Astro</strong> renders the site to static files — pages, lessons, categories, search and the sitemap.</li>
        <li><strong>TypeScript</strong> powers the terminal: an explicit command parser, a virtual filesystem and a deterministic shell.</li>
        <li><strong>Custom CSS</strong> gives the interface and the terminal their own character.</li>
        <li><strong>Markdown</strong> holds the lessons; <strong>JSON</strong> holds the challenge definitions.</li>
      </ul>
      <p>
        The source is on
        <a href="https://github.com/apsideslabs/Learmux" target="_blank" rel="noopener">GitHub</a>
        under the MIT licence.
      </p>

      <h2>Numbers</h2>
    </div>

    <div class="stats">
      <div class="stat"><span class="n">{challenges.length}</span><span class="l">challenges</span></div>
      <div class="stat"><span class="n">{totalPoints}</span><span class="l">points</span></div>
      <div class="stat"><span class="n">{cats.length}</span><span class="l">topics</span></div>
      <div class="stat"><span class="n">50+</span><span class="l">shell commands</span></div>
    </div>

    <div class="actions" style="margin-top:2rem">
      <a class="btn btn--green" href={`${base}challenges/`}>Play the CTF</a>
      <a class="btn btn--outline" href={`${base}learn/`}>Read the lessons</a>
    </div>
  </div>
</BaseLayout>
