---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/tools.css';
import { tools, toolCategories, toolsByCategory } from '../../data/tools';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const groups = toolsByCategory();
const withExamples = tools.filter((t) => t.example).length;
const countFor = (id: string) => groups.find((g) => g.category.id === id)?.items.length ?? 0;
---

<BaseLayout
  title="Tools"
  description={`A directory of ${tools.length} command-line tools that run under Termux, grouped by what they do, with the commands you actually use.`}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={base}>Home</a><span class="sep">›</span><span>Tools</span>
    </nav>

    <header class="tools-head">
      <p class="eyebrow">Reference</p>
      <h1>Tools</h1>
      <p class="lede">
        {tools.length} command-line tools that run under Termux, grouped by what they do. Each one has a
        short explanation, who builds it, and the handful of commands worth memorising.
      </p>
      <p class="tools-head__meta">
        {tools.length} tools · {groups.length} categories · {withExamples} with a worked example · every one
        installable with <code>pkg</code>
      </p>
    </header>

    <!-- browse by category -->
    <div class="section-label"><span>Browse by category</span></div>
    <div class="cat-nav" style="margin-top:1rem">
      {toolCategories.map((c) => (
        <a class="cat-card" href={`${base}tools/category/${c.id}/`}>
          <span class="cat-card__icon"><Icon name="grid" size={17} /></span>
          <span class="cat-card__body">
            <span class="cat-card__name">{c.name}</span>
            <span class="cat-card__blurb">{c.blurb}</span>
          </span>
          <span class="cat-card__count">{countFor(c.id)}</span>
        </a>
      ))}
    </div>

    <!-- filter the full list in place -->
    <div class="tool-filters">
      <div class="tool-search">
        <Icon name="search" size={17} />
        <input
          type="search"
          id="tool-q"
          placeholder="Filter all tools…"
          aria-label="Filter tools by name or purpose"
          autocomplete="off"
        />
      </div>
      <p class="tool-count" id="tool-count" aria-live="polite" style="margin:0"></p>
    </div>

    <div id="tool-groups">
      {groups.map((g) => (
        <section class="tool-group" data-group={g.category.id}>
          <div class="tool-group__head">
            <h2><a href={`${base}tools/category/${g.category.id}/`}>{g.category.name}</a></h2>
            <span class="tool-group__count">{g.items.length}</span>
          </div>
          <p class="tool-group__blurb">{g.category.blurb}</p>

          <div class="tool-grid">
            {g.items.map((t) => (
              <a
                class="tool-card"
                href={`${base}tools/${t.slug}/`}
                data-tool
                data-cat={t.category}
                data-search={`${t.name} ${t.developer} ${t.tagline} ${t.category}`.toLowerCase()}
              >
                <span class="tool-logo">
                  <img src={`${base}logos/${t.slug}.svg`} width="26" height="26" alt="" loading="lazy" />
                </span>
                <span class="tool-card__body">
                  <span class="tool-card__name">{t.name}</span>
                  <span class="tool-card__tagline">{t.tagline}</span>
                  <span class="tool-card__meta">{t.developer}</span>
                </span>
                <span class="tool-card__count" title={`${t.commands.length} commands`}>{t.commands.length}</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p class="tool-empty" id="tool-empty" hidden>No tool matches that. Try a different word.</p>

    <section class="ctf-panel" style="margin-top:2.4rem">
      <h2>Put them to work</h2>
      <p>
        Reading about a tool is not the same as using one. The challenges run these commands against a
        sandbox filesystem, and every one has a flag to find.
      </p>
      <a class="btn btn--green" href={`${base}challenges/`}>Play the CTF</a>
    </section>
  </div>

  <script>
    function initToolFilter() {
      const q = document.getElementById('tool-q') as HTMLInputElement | null;
      if (!q || q.dataset.bound) return;
      q.dataset.bound = '1';

      const groups = Array.from(document.querySelectorAll<HTMLElement>('.tool-group'));
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-tool]'));
      const count = document.getElementById('tool-count');
      const empty = document.getElementById('tool-empty');

      const apply = () => {
        const term = q.value.trim().toLowerCase();
        let shown = 0;
        for (const card of cards) {
          const visible = !term || (card.dataset.search ?? '').includes(term);
          card.hidden = !visible;
          if (visible) shown++;
        }
        for (const group of groups) {
          const any = Array.from(group.querySelectorAll<HTMLElement>('[data-tool]')).some((c) => !c.hidden);
          group.hidden = !any;
        }
        if (count) count.textContent = shown === cards.length ? `${shown} tools` : `${shown} of ${cards.length} tools`;
        if (empty) empty.hidden = shown !== 0;
      };

      q.addEventListener('input', apply);
      apply();
    }

    initToolFilter();
    document.addEventListener('astro:page-load', initToolFilter);
  </script>
</BaseLayout>
