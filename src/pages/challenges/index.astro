---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChallengeRow from '../../components/ChallengeRow.astro';
import { allMeta, categories, totalPoints } from '../../lib/challenges';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const list = allMeta();
const cats = categories();
const byDifficulty = ['Easy', 'Medium', 'Hard'] as const;
const groups = byDifficulty
  .map((d) => ({ difficulty: d, items: list.filter((c) => c.difficulty === d) }))
  .filter((g) => g.items.length);

let counter = 0;
---

<BaseLayout
  title="Play CTF"
  description={`${list.length} terminal-based challenges. Find the flags and complete the challenge. ${totalPoints} points across ${cats.length} topics.`}
>
  <div class="wrap">
    <header class="section--tight">
      <h1>Play CTF</h1>
      <p class="lede">
        {list.length} terminal challenges. Find the flags and finish them. Each one opens a
        sandbox with its own filesystem.
      </p>
    </header>

    <div class="ctf-panel" style="margin-bottom:1.4rem">
      <h2>Want the real thing?</h2>
      <p>
        These challenges run in your browser. There is also a Termux CTF that runs on your
        own phone, against real files with real permissions, where every flag is generated
        on your device.
      </p>
      <p>
        <a class="btn btn--green" href={`${base}ctf/`}>Play the Termux CTF</a>
      </p>
    </div>

    <div class="ctf-panel" style="margin-bottom:1.4rem">
      <h2>Learmux CTF</h2>
      <p>Work through them in order, or jump straight to the hard ones.</p>
      <div class="ctf-meta">
        <span data-progress-chip data-total={list.length}>0 / {list.length} captured</span>
        <span>{totalPoints} points</span>
        <span>{cats.length} topics</span>
      </div>
      <div class="progress-line" style="background:#2a2a33">
        <span data-progress-bar data-total={list.length}></span>
      </div>
    </div>

    <div class="chip-row" style="margin-bottom:0.4rem">
      {cats.map((c) => <span class="chip">{c.name} · {c.count}</span>)}
    </div>

    {groups.map((group) => (
      <section style="margin-top:1.8rem">
        <div class="group-head" style="margin-top:0">
          <h3>{group.difficulty}</h3>
          <span>{group.items.length} challenges · {group.items.reduce((s, c) => s + c.points, 0)} points</span>
        </div>
        <div class="rows">
          {group.items.map((c) => <ChallengeRow challenge={c} index={++counter} />)}
        </div>
      </section>
    ))}

    <section class="section--tight">
      <div class="soft-panel" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem">
        <p class="mb-0 muted">New to the shell? The lessons explain every command the challenges use.</p>
        <a class="btn btn--outline" href={`${base}course/`}>Read the lessons</a>
      </div>
    </section>
  </div>
</BaseLayout>
