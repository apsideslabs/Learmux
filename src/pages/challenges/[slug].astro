---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Terminal from '../../components/Terminal.astro';
import Icon from '../../components/Icon.astro';
import { challenges } from '../../lib/challenges';
import { renderMarkdown } from '../../lib/md';

export async function getStaticPaths() {
  return challenges.map((challenge, idx) => ({
    params: { slug: challenge.slug },
    props: { challenge, idx },
  }));
}

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const { challenge, idx } = Astro.props;
const prev = challenges[idx - 1];
const next = challenges[idx + 1];
const diffClass = { Easy: 'chip--easy', Medium: 'chip--medium', Hard: 'chip--hard' }[challenge.difficulty];
const briefingHtml = renderMarkdown(challenge.briefing);
const num = String(idx + 1).padStart(2, '0');
---

<BaseLayout
  title={challenge.title}
  description={`${challenge.objective} A ${challenge.difficulty.toLowerCase()} ${challenge.category} challenge worth ${challenge.points} points.`}
>
  <div class="wrap">
    <div class="ctf-bar" data-challenge-slug={challenge.slug}>
      <div class="ctf-bar__top">
        <span class="count">Challenge {num} / {challenges.length}</span>
        <a class="ctf-close" href={`${base}challenges/`}>
          <Icon name="close" size={15} /> Close
        </a>
      </div>
      <h1 class="ctf-title">{challenge.title}</h1>
      <div class="chip-row">
        <span class={`chip ${diffClass}`}>{challenge.difficulty}</span>
        <span class="chip">{challenge.category}</span>
        <span class="chip chip--mono">{challenge.points} pts</span>
        <span class="chip chip--solved" data-solved-only>Captured</span>
      </div>
    </div>
    <div class="progress-line" aria-hidden="true">
      <span data-progress-bar data-total={challenges.length}></span>
    </div>

    <div class="section--tight">
      <Terminal challenge={challenge} />
    </div>

    <div style="display:grid;gap:1.2rem;grid-template-columns:1fr;align-items:start">
      <div class="brief">
        <h2>Briefing</h2>
        <div class="prose" style="max-width:none;font-size:1rem">
          <Fragment set:html={briefingHtml} />
        </div>
        <p class="objective">
          <span class="k" style="display:block;font-family:var(--font-mono);font-size:0.74rem;color:var(--muted);margin-bottom:0.2rem">Objective</span>
          {challenge.objective}
        </p>
      </div>

      <div class="soft-panel">
        <h2 style="font-size:1.02rem">Stuck?</h2>
        <p class="muted" style="font-size:0.92rem">
          Type <code>hint</code> in the terminal to reveal hints one at a time, or use the starters below.
        </p>
        <div class="chip-row" style="margin-bottom:0.8rem">
          {(challenge.starters ?? []).map((s) => <span class="chip chip--mono">{s}</span>)}
        </div>
        <details class="hints" style="border-top:1px solid var(--line)">
          <summary style="cursor:pointer;list-style:none;padding:0.5rem 0;font-weight:600;font-size:0.9rem">
            Show all {challenge.hints.length} hint{challenge.hints.length === 1 ? '' : 's'}
          </summary>
          <ol style="margin:0;padding-left:1.15rem;font-size:0.9rem;color:#4d4d55">
            {challenge.hints.map((h) => <li>{h}</li>)}
          </ol>
        </details>
      </div>

      <div class="soft-panel" style="display:flex;flex-wrap:wrap;gap:0.8rem;justify-content:space-between;align-items:center">
        <div class="actions">
          {prev
            ? <a class="btn btn--outline btn--sm" href={`${base}challenges/${prev.slug}/`}>← {prev.title}</a>
            : <span class="muted" style="font-size:0.88rem">This is the first challenge.</span>}
          {next
            ? <a class="btn btn--outline btn--sm" href={`${base}challenges/${next.slug}/`}>{next.title} →</a>
            : <span class="muted" style="font-size:0.88rem">That was the last one. Well done.</span>}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
