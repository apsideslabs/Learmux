---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Terminal from '../../components/Terminal.astro';
import { challenges } from '../../lib/challenges';
import { renderMarkdown } from '../../lib/md';

export async function getStaticPaths() {
  return challenges.map((challenge, idx) => ({
    params: { slug: challenge.slug },
    props: { challenge, idx },
  }));
}

const { challenge, idx } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const prev = challenges[idx - 1];
const next = challenges[idx + 1];
const diffClass = { Easy: 'chip--easy', Medium: 'chip--medium', Hard: 'chip--hard' }[challenge.difficulty];
const briefingHtml = renderMarkdown(challenge.briefing);
---

<BaseLayout
  title={challenge.title}
  description={`${challenge.objective} A ${challenge.difficulty.toLowerCase()} ${challenge.category} challenge worth ${challenge.points} points.`}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={`${base}challenges/`}>Challenges</a> / <span>{challenge.title}</span>
    </nav>

    <div class="detail" data-challenge-slug={challenge.slug}>
      <div class="detail__main">
        <header>
          <div class="chip-row" style="margin-bottom:0.9rem">
            <span class={`chip ${diffClass}`}>{challenge.difficulty}</span>
            <span class="chip">{challenge.category}</span>
            <span class="chip chip--mono">{challenge.points} pts</span>
            <span class="chip chip--solved" data-solved-only>Captured</span>
          </div>
          <h1 style="margin-bottom:0.5rem">{challenge.title}</h1>
          <p class="lede" style="font-size:1.08rem">{challenge.summary}</p>
        </header>

        <Terminal challenge={challenge} />

        <div class="brief">
          <h2>Briefing</h2>
          <div class="prose" style="max-width:none">
            <Fragment set:html={briefingHtml} />
          </div>
          <p class="objective">
            <span class="k">Objective</span>
            {challenge.objective}
          </p>
        </div>
      </div>

      <aside class="detail__aside">
        <div class="side-card">
          <h3>Hints</h3>
          <p>Try it yourself first — then open these one at a time.</p>
          <details class="hints">
            <summary>Show {challenge.hints.length} hint{challenge.hints.length === 1 ? '' : 's'}</summary>
            <ol>
              {challenge.hints.map((h) => <li>{h}</li>)}
            </ol>
          </details>
        </div>

        <div class="side-card">
          <h3>Try these</h3>
          <p class="mb-0">Tap one to drop it into the terminal, then press Enter.</p>
          <ul class="starters">
            {(challenge.starters ?? []).map((s) => <li>{s}</li>)}
          </ul>
        </div>

        <div class="side-card">
          <h3>Keep going</h3>
          <div class="pager">
            {prev
              ? <a href={`${base}challenges/${prev.slug}/`}><span class="k">Previous</span><span class="t">{prev.title}</span></a>
              : <span class="muted" style="font-size:0.88rem">This is the first challenge.</span>}
            {next
              ? <a href={`${base}challenges/${next.slug}/`}><span class="k">Next</span><span class="t">{next.title}</span></a>
              : <span class="muted" style="font-size:0.88rem">That was the last one — well done.</span>}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
