---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';
import { challenges, categories, totalPoints } from '../lib/challenges';
import { recentTutorials } from '../lib/tutorials';
import { social } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const recent = await recentTutorials();
const [lead, ...rest] = recent;
const featured = rest.slice(0, 2);
const feed = rest.slice(2);
const cats = categories();
---

<BaseLayout>
  <section class="wrap section">
    <div class="section-label"><span>Featured</span></div>
    {lead && <div style="margin-bottom:1.1rem"><ArticleCard entry={lead} variant="hero" /></div>}
    <div class="cards cards--2">
      {featured.map((t) => <ArticleCard entry={t} />)}
    </div>
  </section>

  <section class="wrap">
    <div class="section-label"><span>Recent posts</span></div>
    <div class="posts">
      {feed.map((t) => <PostRow entry={t} />)}
    </div>
  </section>

  <section class="wrap section">
    <div class="ctf-panel">
      <h2>Learmux CTF</h2>
      <p>Terminal-based challenges. Find the flags and complete the challenge.</p>
      <div class="ctf-meta">
        <span>{challenges.length} challenges</span>
        <span>{totalPoints} points</span>
        <span>{cats.length} topics</span>
      </div>
      <a class="btn btn--green btn--lg" href={`${base}challenges/`}>Play CTF</a>
    </div>
  </section>

  <section class="wrap section--tight">
    <div class="soft-panel">
      <h2>Download Termux</h2>
      <p class="muted" style="max-width:60ch">
        Termux is a free terminal emulator and Linux environment for Android — no root required.
        Install it, then work through the lessons on your phone.
      </p>
      <div class="actions">
        <a class="btn btn--navy" href="https://f-droid.org/en/packages/com.termux/" target="_blank" rel="noopener">Get it on F-Droid</a>
        <a class="btn btn--outline" href="https://play.google.com/store/apps/details" target="_blank" rel="noopener">Google Play</a>
      </div>
    </div>
  </section>

  <section class="wrap section--tight">
    <div class="section-label"><span>Follow</span></div>
    <div class="social">
      {social.map((s) => (
        <a href={s.href} aria-label={s.label} title={s.label} target="_blank" rel="noopener">
          <Icon name={s.icon as any} size={19} />
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
