---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Terminal from '../components/Terminal.astro';
import Icon from '../components/Icon.astro';
import { challenges, totalPoints } from '../lib/challenges';
import { trackGroups, allTutorials } from '../lib/tutorials';
import { course } from '../lib/curriculum';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const groups = await trackGroups();
const lessons = await allTutorials();

// Three lessons that between them show the range: the first thing you ever do,
// the shell doing real work, and the Python track. Chosen, not sorted.
const bySlug = new Map(lessons.map((l) => [l.id, l]));
const featured = ['getting-started', 'pipes-and-redirection', 'run-your-first-python']
  .map((slug) => bySlug.get(slug))
  .filter((l): l is NonNullable<typeof l> => Boolean(l));

const demo = challenges.find((c) => c.slug === 'first-steps') ?? challenges[0];
const topics = new Set(challenges.map((c) => c.category)).size;

// Four things, short enough to read in one pass. A list of seven sentences is
// a document; this is a signpost.
const outcomes = [
  'Find any file and pull what you need out of it.',
  'Write a script that runs on a schedule.',
  'Read an HTTP response and a log by hand.',
  'Run Python without installing anything.',
];
---

<BaseLayout>
  <!-- ── the promise, and the product next to it ─────────────────────────── -->
  <section class="band band--hero">
    <div class="wrap hero">
      <div class="hero__copy">
        <p class="eyebrow">Termux · Linux · Security</p>
        <h1>Learn the Linux command line on your phone.</h1>
        <p class="lede">
          {lessons.length} lessons, {groups.length} tracks, {challenges.length} challenges. Read a
          short lesson, then type the commands yourself.
        </p>
        <div class="actions">
          <a class="btn btn--green" href={`${base}course/`}>Start the course</a>
          <a class="btn btn--outline" href={`${base}challenges/`}>Open the sandbox</a>
        </div>
        <p class="hero__facts">
          {course.timeEstimate} · no account · nothing to install to read
        </p>
      </div>

      <div class="hero__demo">
        <Terminal challenge={demo} compact />
        <p class="hero__demo-note">
          A real sandbox, running here. <a href={`${base}challenges/`}>All {challenges.length} challenges</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ── what it adds up to ──────────────────────────────────────────────── -->
  <section class="band band--soft">
    <div class="wrap">
      <div class="duo">
        <div class="duo__head">
          <p class="eyebrow">Outcomes</p>
          <h2>What you can do at the end</h2>
          <p class="muted">Not a command reference. Four things you will be able to do.</p>
        </div>
        <ul class="outcomes__list outcomes__list--two">
          {outcomes.map((o) => <li>{o}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── the course ──────────────────────────────────────────────────────── -->
  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">The course</p>
          <h2>{groups.length} tracks, in order</h2>
        </div>
        <p class="section-head__meta">
          {lessons.length} lessons · {course.timeEstimate}
        </p>
      </div>

      <div class="path-grid">
        {groups.map((g) => (
          <a class="path-card" href={`${base}course/${g.track.id}/`}>
            <span class="path-card__top">
              <span class="path-card__num">{String(g.track.number).padStart(2, '0')}</span>
              <span class="path-card__level">{g.track.level}</span>
            </span>
            <span class="path-card__title">{g.track.title}</span>
            <span class="path-card__tag">{g.track.tagline}</span>
            <span class="path-card__go">
              {g.lessons.length} lessons <Icon name="arrow" size={14} />
            </span>
          </a>
        ))}
      </div>

      <div class="actions actions--end">
        <a class="btn btn--outline" href={`${base}course/`}>The full curriculum</a>
      </div>
    </div>
  </section>

  <!-- ── where to begin ──────────────────────────────────────────────────── -->
  <section class="band band--soft">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Start here</p>
          <h2>Three lessons that show the range</h2>
        </div>
        <p class="section-head__meta">
          <a href={`${base}course/`}>All {lessons.length} lessons</a>
        </p>
      </div>
      <div class="cards cards--3">
        {featured.map((t) => <ArticleCard entry={t} />)}
      </div>
    </div>
  </section>

  <!-- ── the second way in ───────────────────────────────────────────────── -->
  <section class="band band--navy">
    <div class="wrap ctf-panel ctf-panel--band">
      <div class="ctf-panel__body">
        <p class="eyebrow eyebrow--onDark">Practise</p>
        <h2>Learmux CTF</h2>
        <p>
          {challenges.length} challenges across {topics} topics. Each opens its own filesystem. Find
          the flag to finish it.
        </p>
        <div class="ctf-meta">
          <span data-progress-chip data-total={challenges.length}>0 / {challenges.length} captured</span>
          <span>{totalPoints} points</span>
        </div>
        <div class="progress-line progress-line--onDark">
          <span data-progress-bar data-total={challenges.length}></span>
        </div>
        <a class="btn btn--green" href={`${base}challenges/`}>Play the CTF</a>
      </div>

      <!-- What a finished challenge looks like, in the shape you type it. -->
      <div class="ctf-panel__spec">
        <pre class="ctf-panel__spec-code"><span class="ctf-panel__prompt">player@termux</span> <span class="ctf-panel__dollar">$</span> ls
notes.txt
<span class="ctf-panel__prompt">player@termux</span> <span class="ctf-panel__dollar">$</span> cat notes.txt
the flag is FLAG&#123;first_steps&#125;
<span class="ctf-panel__prompt">player@termux</span> <span class="ctf-panel__dollar">$</span> submit FLAG&#123;first_steps&#125;
<span class="ctf-panel__ok">Correct. 20 points.</span></pre>
      </div>
    </div>
  </section>

  <!-- ── the prerequisite ────────────────────────────────────────────────── -->
  <section class="band">
    <div class="wrap">
      <div class="duo duo--middle">
        <div class="duo__head">
          <p class="eyebrow">Before you start</p>
          <h2>You need Termux</h2>
          <p class="muted">
            A free terminal for Android. No root, no account. Install it from F-Droid, then work
            through the course on the phone in your hand.
          </p>
        </div>
        <div class="actions">
          <a class="btn btn--green" href="https://f-droid.org/en/packages/com.termux/" target="_blank" rel="noopener">
            Get it on F-Droid
          </a>
          <a class="btn btn--outline" href={`${base}learn/getting-started/`}>The setup lesson</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
