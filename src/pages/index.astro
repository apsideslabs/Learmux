---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Terminal from '../components/Terminal.astro';
import Icon from '../components/Icon.astro';
import { challenges, totalPoints } from '../lib/challenges';
import { trackGroups, allTutorials } from '../lib/tutorials';
import { course } from '../lib/curriculum';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const groups = await trackGroups();
const lessons = await allTutorials();

// Three lessons that between them show what the course is: the first thing you
// ever do, the shell doing real work, and the Python track where code runs in
// the page. Chosen by hand, because a feed ordered by a date was only ever
// ordered by a date nobody had.
const bySlug = new Map(lessons.map((l) => [l.id, l]));
const featured = ['getting-started', 'pipes-and-redirection', 'run-your-first-python']
  .map((slug) => bySlug.get(slug))
  .filter((l): l is NonNullable<typeof l> => Boolean(l));

const demo = challenges.find((c) => c.slug === 'first-steps') ?? challenges[0];
const topics = new Set(challenges.map((c) => c.category)).size;

const outcomes = [
  'Find your way around a Linux filesystem and pull what you need out of a file.',
  'Write a small script, run it on a schedule, and process a large file without opening it.',
  'Write Python and run it in the page, with no install and no server, and read the traceback when it goes wrong.',
  'Explain what happens when you open a page, and read an HTTP response by hand.',
  'Check a file against its hash and spot the entries in a log that do not belong.',
  'Build three working tools of your own: a backup script, a log analyser, a dashboard.',
  'Keep your own device updated, tidy and locked down.',
];
---

<BaseLayout>
  <!-- ── hero: the promise, then the product itself ─────────────────────── -->
  <section class="wrap hero">
    <div class="hero__copy">
      <p class="eyebrow">Termux · Linux · Security</p>
      <h1>Learn the command line by using it.</h1>
      <p class="lede">
        A course for Android's Termux, in twelve tracks. Read a short lesson, then prove it in a real
        terminal. Every challenge has a flag to find.
      </p>
      <div class="actions">
        <a class="btn btn--green" href={`${base}course/`}>Start the course</a>
        <a class="btn btn--outline" href={`${base}challenges/`}>Play the CTF</a>
      </div>
      <p class="hero__facts">
        {groups.length} tracks · {lessons.length} lessons · {challenges.length} challenges ·
        {course.timeEstimate} · no account needed
      </p>
    </div>

    <div class="hero__demo">
      <p class="hero__demo-label">Live sandbox. Type in it.</p>
      <Terminal challenge={demo} compact />
      <p class="hero__demo-note">
        Challenge 01 of {challenges.length} · <a href={`${base}challenges/`}>see all challenges</a>
      </p>
    </div>
  </section>

  <!-- ── claim, then proof ──────────────────────────────────────────────── -->
  <section class="wrap section--tight">
    <div class="outcomes">
      <div class="outcomes__intro">
        <h2>What you will be able to do</h2>
        <p class="muted">
          This is not a list of commands to memorise. By the end of the course you can sit down at a
          Linux prompt and get something done.
        </p>
      </div>
      <ul class="outcomes__list">
        {outcomes.map((o) => <li>{o}</li>)}
      </ul>
    </div>
  </section>

  <!-- ── the curriculum ─────────────────────────────────────────────────── -->
  <section class="wrap section--tight">
    <div class="section-head">
      <div>
        <p class="eyebrow">The path</p>
        <h2>Twelve tracks, in order</h2>
      </div>
      <p class="section-head__meta">
        {groups.length} tracks · {lessons.length} lessons · {course.timeEstimate}
      </p>
    </div>

    <div class="path-grid">
      {groups.map((g) => (
        <a class="path-card" href={`${base}course/${g.track.id}/`}>
          <span class="path-card__top">
            <span class="path-card__num">{String(g.track.number).padStart(2, '0')}</span>
            <span class="path-card__level">{g.track.level}</span>
          </span>
          <span class="path-card__title">{g.track.title}</span>
          <span class="path-card__tag">{g.track.tagline}</span>
          <span class="path-card__first">Starts with {g.lessons[0].data.title}</span>
          <span class="path-card__go">
            {g.lessons.length} lessons <Icon name="arrow" size={14} />
          </span>
        </a>
      ))}
    </div>

    <div class="actions" style="margin-top:1.5rem">
      <a class="btn btn--outline" href={`${base}course/`}>See the full curriculum</a>
    </div>
  </section>

  <!-- ── three lessons that show the range ──────────────────────────────── -->
  <section class="wrap section--tight">
    <div class="section-head">
      <div>
        <p class="eyebrow">Start with these</p>
        <h2>Three lessons that show what this is</h2>
      </div>
      <p class="section-head__meta">
        <a href={`${base}course/`}>All {lessons.length} lessons</a>
      </p>
    </div>
    <div class="cards cards--3">
      {featured.map((t) => <ArticleCard entry={t} />)}
    </div>
  </section>

  <!-- ── the second way in: practise ────────────────────────────────────── -->
  <section class="wrap section--tight">
    <div class="ctf-panel">
      <div class="ctf-panel__body">
        <h2>Learmux CTF</h2>
        <p>
          {challenges.length} terminal challenges across {topics} topics, worth {totalPoints} points.
          Each one opens a sandbox with its own filesystem. Find the flag to finish it.
        </p>
        <div class="ctf-meta">
          <span data-progress-chip data-total={challenges.length}>0 / {challenges.length} captured</span>
          <span>{totalPoints} points</span>
        </div>
        <div class="progress-line progress-line--onDark">
          <span data-progress-bar data-total={challenges.length}></span>
        </div>
        <a class="btn btn--green" href={`${base}challenges/`}>Play CTF</a>
      </div>

      <!-- What a finished challenge looks like, in the shape the reader will
           actually type it. -->
      <div class="ctf-panel__spec">
        <p class="ctf-panel__spec-label">A finished challenge</p>
        <pre class="ctf-panel__spec-code"><span class="ctf-panel__prompt">player@termux</span> <span class="ctf-panel__tilde">~</span> <span class="ctf-panel__dollar">$</span> ls
notes.txt
<span class="ctf-panel__prompt">player@termux</span> <span class="ctf-panel__tilde">~</span> <span class="ctf-panel__dollar">$</span> cat notes.txt
the flag is FLAG&#123;first_steps&#125;
<span class="ctf-panel__prompt">player@termux</span> <span class="ctf-panel__tilde">~</span> <span class="ctf-panel__dollar">$</span> submit FLAG&#123;first_steps&#125;
<span class="ctf-panel__ok">Correct. 20 points.</span></pre>
      </div>
    </div>
  </section>

  <!-- ── the prerequisite ───────────────────────────────────────────────── -->
  <section class="wrap section--tight">
    <div class="download">
      <div>
        <h2>Download Termux</h2>
        <p>
          Termux is a free terminal and Linux environment for Android. It does not need root. Install it
          from F-Droid, then work through the course on your phone.
        </p>
      </div>
      <div class="actions">
        <a class="btn btn--green" href="https://f-droid.org/en/packages/com.termux/" target="_blank" rel="noopener">
          Get it on F-Droid
        </a>
        <a class="btn btn--outline" href={`${base}learn/getting-started/`}>Read the setup lesson</a>
      </div>
    </div>
  </section>
</BaseLayout>
