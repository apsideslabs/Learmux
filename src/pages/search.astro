---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';
import { allTutorials } from '../lib/tutorials';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const tutorials = await allTutorials();
---

<BaseLayout
  title="Search"
  description="Search the Learmux tutorials by title, topic or tag."
  noindex
>
  <div class="wrap">
    <header class="section">
      <h1>Search</h1>
      <p class="lede">Find a lesson by title, category or tag.</p>
    </header>

    <div class="search-box" style="max-width:560px">
      <Icon name="search" size={18} />
      <label class="visually-hidden" for="q">Search tutorials</label>
      <input id="q" type="search" placeholder="e.g. grep, permissions, base64" autocomplete="off" />
    </div>

    <p class="muted" data-count style="margin-top:0.9rem;font-size:0.88rem"></p>

    <div class="posts" data-results>
      {tutorials.map((t) => (
        <div
          data-item
          data-text={`${t.data.title} ${t.data.category} ${t.data.excerpt} ${t.data.tags.join(' ')}`.toLowerCase()}
        >
          <PostRow entry={t} />
        </div>
      ))}
    </div>

    <p class="muted" data-empty hidden style="padding:2rem 0">No lessons matched that search.</p>
  </div>

  <script>
    function initSearch() {
      const input = document.querySelector<HTMLInputElement>('#q');
      const items = Array.from(document.querySelectorAll<HTMLElement>('[data-item]'));
      const count = document.querySelector('[data-count]');
      const empty = document.querySelector<HTMLElement>('[data-empty]');
      if (!input || input.dataset.bound) return;
      input.dataset.bound = '1';

      const render = () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        for (const el of items) {
          const match = q === '' || (el.dataset.text ?? '').includes(q);
          el.hidden = !match;
          if (match) shown++;
        }
        if (count) count.textContent = q === '' ? `${items.length} lessons` : `${shown} of ${items.length} lessons`;
        if (empty) empty.hidden = shown !== 0;
      };

      input.addEventListener('input', render);
      render();
      input.focus();
    }

    initSearch();
    document.addEventListener('astro:page-load', initSearch);
  </script>
</BaseLayout>
