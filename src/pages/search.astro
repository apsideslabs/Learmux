---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';
import { allTutorials } from '../lib/tutorials';
import { tools } from '../data/tools';
import '../styles/tools.css';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const tutorials = await allTutorials();
---

<BaseLayout
  title="Search"
  description="Search the Learmux lessons and the tool directory."
  noindex
>
  <div class="wrap">
    <header class="section">
      <h1>Search</h1>
      <p class="lede">Find a lesson or a tool by name, topic or tag.</p>
    </header>

    <div class="search-box" style="max-width:560px">
      <Icon name="search" size={18} />
      <label class="visually-hidden" for="q">Search lessons and tools</label>
      <input id="q" type="search" placeholder="e.g. grep, permissions, nmap" autocomplete="off" />
    </div>

    <p class="muted" data-count style="margin-top:0.9rem;font-size:0.88rem"></p>

    <div class="posts" data-results>
      {tutorials.map((t) => (
        <div
          data-item
          data-text={`${t.data.title} ${t.data.category} ${t.data.excerpt} ${t.data.tags.join(' ')}`.toLowerCase()}
        >
          <PostRow entry={t} />
        </div>
      ))}
    </div>

    <div data-tools-block>
    <div class="section-label" style="margin-top:2rem"><span>Tools</span></div>
    <div class="tool-grid" data-results>
      {tools.map((t) => (
        <div
          data-item
          data-text={`${t.name} ${t.category} ${t.tagline} ${t.developer} ${t.license ?? ''}`.toLowerCase()}
        >
          <a class="tool-card" href={`${base}tools/${t.slug}/`}>
            <span class="tool-logo">
              <img src={`${base}logos/${t.slug}.svg`} width="26" height="26" alt="" loading="lazy" />
            </span>
            <span class="tool-card__body">
              <span class="tool-card__name">{t.name}</span>
              <span class="tool-card__tagline">{t.tagline}</span>
              <span class="tool-card__meta">{t.developer}</span>
            </span>
          </a>
        </div>
      ))}
    </div>
    </div>

    <p class="muted" data-empty hidden style="padding:2rem 0">Nothing matched that search.</p>
  </div>

  <script>
    function initSearch() {
      const input = document.querySelector<HTMLInputElement>('#q');
      const items = Array.from(document.querySelectorAll<HTMLElement>('[data-item]'));
      const count = document.querySelector('[data-count]');
      const empty = document.querySelector<HTMLElement>('[data-empty]');
      if (!input || input.dataset.bound) return;
      input.dataset.bound = '1';

      const render = () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        for (const el of items) {
          const match = q === '' || (el.dataset.text ?? '').includes(q);
          el.hidden = !match;
          if (match) shown++;
        }
        // hide a section heading when everything under it is filtered out
        for (const grid of document.querySelectorAll<HTMLElement>('[data-results]')) {
          const any = Array.from(grid.querySelectorAll<HTMLElement>('[data-item]')).some((el) => !el.hidden);
          grid.hidden = !any;
        }
        // and the "Tools" heading that belongs to the tools grid
        const toolsBlock = document.querySelector<HTMLElement>('[data-tools-block]');
        if (toolsBlock) {
          const anyTool = Array.from(toolsBlock.querySelectorAll<HTMLElement>('[data-item]')).some((el) => !el.hidden);
          toolsBlock.hidden = !anyTool;
        }
        if (count) count.textContent = q === '' ? `${items.length} items` : `${shown} of ${items.length} items`;
        if (empty) empty.hidden = shown !== 0;
      };

      input.addEventListener('input', render);
      render();
      input.focus();
    }

    initSearch();
    document.addEventListener('astro:page-load', initSearch);
  </script>
</BaseLayout>
