---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/utilities.css';
import { utilityBySlug, otherUtilities } from '../../data/utilities';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const u = utilityBySlug('password-generator')!;
const others = otherUtilities('password-generator');
---

<BaseLayout
  title="Password generator"
  description="Generate a random password or a Diceware passphrase, with the real entropy in bits and an honest verdict on the strength."
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={base}>Home</a><span class="sep">›</span>
      <a href={`${base}utilities/`}>Utilities</a><span class="sep">›</span>
      <span>Password generator</span>
    </nav>

    <header class="util-hero">
      <h1>Password generator</h1>
      <p class="lede">
        Random passwords and passphrases, drawn from your device's own random source. The
        entropy figure below is the real one, not a score invented to make you feel good
        about six characters.
      </p>
    </header>

    <div class="util-panel">
      <div class="util-panel__head">
        <h2 class="util-panel__title">Generate</h2>
        <div class="util-toggles" role="group" aria-label="Mode">
          <button class="util-toggle" type="button" data-mode="password" aria-pressed="true">Password</button>
          <button class="util-toggle" type="button" data-mode="passphrase" aria-pressed="false">Passphrase</button>
        </div>
      </div>

      <div class="util-panel__body">
        <!-- password mode -->
        <div data-pane="password">
          <div class="util-row">
            <label class="util-field">
              <span class="util-label">Length</span>
              <input class="util-input" id="len" type="number" min="8" max="128" value="20" />
            </label>
            <label class="util-field" style="flex:2 1 18rem">
              <span class="util-label">Length slider</span>
              <input id="lenRange" type="range" min="8" max="128" value="20" style="width:100%;accent-color:var(--green)" />
            </label>
          </div>

          <div class="util-row">
            <div class="util-field" style="flex:1 1 100%">
              <span class="util-label">Include</span>
              <div class="util-toggles">
                <button class="util-toggle" type="button" data-set="lowercase" aria-pressed="true">
                  <span class="util-toggle__mark">✓</span> a-z
                </button>
                <button class="util-toggle" type="button" data-set="uppercase" aria-pressed="true">
                  <span class="util-toggle__mark">✓</span> A-Z
                </button>
                <button class="util-toggle" type="button" data-set="digits" aria-pressed="true">
                  <span class="util-toggle__mark">✓</span> 0-9
                </button>
                <button class="util-toggle" type="button" data-set="symbols" aria-pressed="true">
                  <span class="util-toggle__mark">✓</span> symbols
                </button>
              </div>
            </div>
          </div>

          <div class="util-row">
            <div class="util-field" style="flex:1 1 100%">
              <span class="util-label">Options</span>
              <div class="util-toggles">
                <button class="util-toggle" type="button" data-opt="excludeAmbiguous" aria-pressed="true">
                  <span class="util-toggle__mark">✓</span> Skip lookalikes (I l 1 O 0 o)
                </button>
                <button class="util-toggle" type="button" data-opt="requireEachSet" aria-pressed="true">
                  <span class="util-toggle__mark">✓</span> At least one of each class
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- passphrase mode -->
        <div data-pane="passphrase" hidden>
          <div class="util-row">
            <label class="util-field">
              <span class="util-label">Words</span>
              <input class="util-input" id="words" type="number" min="3" max="12" value="6" />
            </label>
            <label class="util-field util-field--narrow">
              <span class="util-label">Separator</span>
              <input class="util-input" id="sep" type="text" value="-" maxlength="3" />
            </label>
          </div>
          <div class="util-row">
            <div class="util-field" style="flex:1 1 100%">
              <span class="util-label">Options</span>
              <div class="util-toggles">
                <button class="util-toggle" type="button" data-popt="capitalise" aria-pressed="false">
                  <span class="util-toggle__mark">✓</span> Capitalise
                </button>
                <button class="util-toggle" type="button" data-popt="appendNumber" aria-pressed="false">
                  <span class="util-toggle__mark">✓</span> Add a two digit number
                </button>
              </div>
            </div>
          </div>
          <p class="util-msg" style="margin-top:1rem">
            <Icon name="info" size={16} />
            <span>
              The words come from the EFF long word list, 7776 of them, which is the standard
              Diceware list. Each word is worth 12.9 bits, so six words beat almost any
              password a person invents.
            </span>
          </p>
        </div>

        <div class="util-actions">
          <button class="util-btn util-btn--primary" id="gen" type="button">
            <Icon name="key" size={15} /> Generate
          </button>
          <button class="util-btn" id="copy" type="button">
            <Icon name="copy" size={15} /> Copy
          </button>
        </div>

        <div class="util-out-head">
          <h3>Result</h3>
          <span class="util-cell__k" id="meta"></span>
        </div>
        <div class="util-out util-out--big" id="out">Press Generate.</div>

        <div class="util-out-head">
          <h3>Entropy</h3>
          <span class="util-cell__k" id="bitsLabel"></span>
        </div>
        <div class="util-meter" id="meter" data-verdict="weak"><span style="width:0%"></span></div>
        <div class="util-msg" id="verdict">
          <Icon name="info" size={16} />
          <span>Entropy is measured in bits: each extra bit doubles the number of guesses an attacker needs.</span>
        </div>
      </div>
    </div>

    <section>
      <h2>What this is actually doing</h2>
      <p>
        Every character comes from <code>crypto.getRandomValues</code>, the browser's
        cryptographic random source. The obvious alternative, <code>Math.random</code>, is a
        fast pseudo-random generator seeded from a value an attacker can often work out, and
        it should never be used for anything a person will treat as a secret.
      </p>
      <p>
        The second thing worth knowing is why the generator discards some random numbers
        rather than using all of them. If you take a random number and divide it by the size
        of your alphabet, the first few characters come up slightly more often than the rest.
        That is modulo bias, and it shrinks the space an attacker has to search. This one
        throws away the values that would cause it, which is why the entropy figure is exact
        rather than approximate.
      </p>
      <p>
        The figure itself is <code>length × log₂(alphabet)</code>. It assumes the password is
        used on a system that stores it properly. If a site stores passwords with a fast hash
        and no salt, no amount of length saves a short password, because the attacker is not
        guessing your password, they are guessing everyone's at once.
      </p>
    </section>

    <div class="util-build">
      <div class="util-build__copy">
        <h2>Build it yourself</h2>
        <p>
          The same generator in a dozen lines of shell, using <code>/dev/urandom</code>,
          <code>tr</code> and <code>openssl</code>, plus the entropy arithmetic and why the
          shell's own <code>$RANDOM</code> is not good enough.
        </p>
      </div>
      <a class="btn btn--green" href={`${base}learn/${u.lesson}/`}>Read the lesson</a>
    </div>

    <section>
      <h2>Other utilities</h2>
      <div class="util-cards">
        {others.map((o) => (
          <section class="util-card">
            <div class="util-card__head">
              <span class="util-card__icon"><Icon name={o.icon} size={18} /></span>
              <h2><a href={`${base}utilities/${o.slug}/`}>{o.name}</a></h2>
            </div>
            <p class="util-card__desc">{o.tagline}</p>
            <div class="util-card__links">
              <a class="is-tool" href={`${base}utilities/${o.slug}/`}>Open <Icon name="arrow" size={13} /></a>
            </div>
          </section>
        ))}
      </div>
    </section>
  </div>

  <script>
    import {
      generatePassword,
      generatePassphrase,
      strengthOf,
      alphabetFor,
      CHAR_SETS,
      type CharSetName,
    } from '../../lib/utilities/random';

    function initPasswordTool() {
      const root = document.querySelector('[data-pane="password"]')?.closest('.util-panel');
      if (!root || (root as HTMLElement).dataset.bound) return;
      (root as HTMLElement).dataset.bound = '1';

      const $ = <T extends HTMLElement>(sel: string) => root.querySelector(sel) as T;
      const out = $('#out');
      const meta = $('#meta');
      const bitsLabel = $('#bitsLabel');
      const meter = $('#meter');
      const meterBar = meter.querySelector('span') as HTMLElement;
      const verdict = $('#verdict');

      const lenInput = $('#len') as HTMLInputElement;
      const lenRange = $('#lenRange') as HTMLInputElement;
      const wordsInput = $('#words') as HTMLInputElement;
      const sepInput = $('#sep') as HTMLInputElement;

      let mode: 'password' | 'passphrase' = 'password';
      const sets = new Set<CharSetName>(['lowercase', 'uppercase', 'digits', 'symbols']);
      let excludeAmbiguous = true;
      let requireEachSet = true;
      let capitalise = false;
      let appendNumber = false;

      const pressed = (el: Element) => el.getAttribute('aria-pressed') === 'true';

      root.querySelectorAll<HTMLElement>('[data-mode]').forEach((btn) => {
        btn.addEventListener('click', () => {
          mode = btn.dataset.mode as 'password' | 'passphrase';
          root.querySelectorAll<HTMLElement>('[data-mode]').forEach((b) =>
            b.setAttribute('aria-pressed', String(b === btn)),
          );
          (root.querySelector('[data-pane="password"]') as HTMLElement).hidden = mode !== 'password';
          (root.querySelector('[data-pane="passphrase"]') as HTMLElement).hidden = mode !== 'passphrase';
          run();
        });
      });

      root.querySelectorAll<HTMLElement>('[data-set]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const name = btn.dataset.set as CharSetName;
          if (sets.has(name)) {
            if (sets.size === 1) return; // never let the alphabet empty out
            sets.delete(name);
          } else {
            sets.add(name);
          }
          btn.setAttribute('aria-pressed', String(sets.has(name)));
          run();
        });
      });

      root.querySelectorAll<HTMLElement>('[data-opt]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const on = !pressed(btn);
          btn.setAttribute('aria-pressed', String(on));
          if (btn.dataset.opt === 'excludeAmbiguous') excludeAmbiguous = on;
          if (btn.dataset.opt === 'requireEachSet') requireEachSet = on;
          run();
        });
      });

      root.querySelectorAll<HTMLElement>('[data-popt]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const on = !pressed(btn);
          btn.setAttribute('aria-pressed', String(on));
          if (btn.dataset.popt === 'capitalise') capitalise = on;
          if (btn.dataset.popt === 'appendNumber') appendNumber = on;
          run();
        });
      });

      const sync = (from: HTMLInputElement, to: HTMLInputElement) => {
        from.addEventListener('input', () => {
          const v = String(Math.max(Number(from.min), Math.min(Number(from.max), Number(from.value) || Number(from.min))));
          to.value = v;
          run();
        });
      };
      sync(lenRange, lenInput);
      sync(lenInput, lenRange);

      [wordsInput, sepInput].forEach((el) => el.addEventListener('input', run));
      $('#gen').addEventListener('click', run);

      $('#copy').addEventListener('click', async () => {
        const text = out.textContent ?? '';
        if (!text || text === 'Press Generate.') return;
        const btn = $('#copy');
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        const original = btn.innerHTML;
        btn.innerHTML = '<span>Copied</span>';
        window.setTimeout(() => {
          btn.innerHTML = original;
        }, 1200);
      });

      function run() {
        let value = '';
        let bits = 0;
        let detail = '';

        if (mode === 'password') {
          const length = Math.max(8, Math.min(128, Number(lenInput.value) || 20));
          const result = generatePassword({
            length,
            sets: [...sets],
            excludeAmbiguous,
            requireEachSet,
          });
          value = result.value;
          bits = result.bits;
          detail = `${length} characters · alphabet ${result.alphabetSize} · ${result.present.length} of ${sets.size} classes`;
        } else {
          const count = Math.max(3, Math.min(12, Number(wordsInput.value) || 6));
          const result = generatePassphrase({
            words: count,
            separator: sepInput.value === '' ? '-' : sepInput.value,
            capitalise,
            appendNumber,
          });
          value = result.value;
          bits = result.bits;
          detail = `${count} words from 7776 · ${result.bits.toFixed(1)} bits`;
        }

        out.textContent = value;
        out.classList.remove('util-out--empty');
        meta.textContent = detail;
        bitsLabel.textContent = `${bits.toFixed(1)} bits`;

        const v = strengthOf(bits);
        meter.dataset.verdict = v.verdict;
        // 128 bits fills the bar, which is where brute force stops being the
        // interesting attack.
        meterBar.style.width = `${Math.min(100, (bits / 128) * 100)}%`;
        verdict.className = 'util-msg' + (v.verdict === 'weak' ? ' util-msg--bad' : v.verdict === 'fair' ? ' util-msg--warn' : ' util-msg--ok');
        verdict.innerHTML = `<strong>${v.label}.</strong> ${v.note}`;
      }

      // Draw one immediately so the page is never blank.
      run();
    }

    initPasswordTool();
    document.addEventListener('astro:page-load', initPasswordTool);
  </script>
</BaseLayout>
