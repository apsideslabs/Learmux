---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/glossary.css';
import { getCollection } from 'astro:content';
import { terms, categories, countIn, initials, haystack, totalTerms } from '../../data/glossary';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';

/**
 * Where each term is actually used, and what keeps turning up beside it.
 *
 * A list of definitions is a dictionary. What makes a glossary navigable is
 * knowing that "Salt" sits near "KDF" and "Rainbow table", and that fact is
 * already implicit in the course: terms that appear in the same lessons are
 * related in the way this course means them. So the graph is derived from the
 * lesson text rather than invented by hand, which also means it cannot drift
 * out of date.
 */
const lessons = await getCollection('tutorials');

/** Escape a term for use inside a regular expression. */
const reEscape = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

/**
 * A pattern that matches a term as a whole word.
 *
 * Word boundaries only make sense next to word characters, so a term like
 * "O(1)" or "127.0.0.1" gets a plain match instead of a \b that would never
 * fire.
 */
function termPattern(text: string): RegExp {
  const body = reEscape(text.trim());
  const lead = /^\w/.test(text) ? '\\b' : '';
  const tail = /\w$/.test(text) ? '\\b' : '';
  return new RegExp(`${lead}${body}${tail}`, 'i');
}

// One lowercase blob per lesson, so each term is tested once per lesson rather
// than once per occurrence.
const lessonText = lessons.map((l) => ({
  slug: l.id,
  title: l.data.title as string,
  text: `${l.data.title ?? ''}\n${l.body ?? ''}`,
}));

const patterns = terms.map((t) => [t, [t.term, ...(t.also ?? [])].map(termPattern)] as const);

/** term -> the indices of the lessons that mention it */
const appearsIn = new Map<string, number[]>();
for (const [term, pats] of patterns) {
  const hits: number[] = [];
  for (let i = 0; i < lessonText.length; i++) {
    if (pats.some((re) => re.test(lessonText[i].text))) hits.push(i);
  }
  appearsIn.set(term.term, hits);
}

/**
 * The three closest terms.
 *
 * Two signals, both taken from the material rather than invented. Sharing
 * lessons is the stronger one, because the course taught them together.
 * Naming each other in a definition is the second, and it is what covers the
 * terms that only appear once: "Salt" explains itself in terms of hashing even
 * if the word salt never reaches a lesson.
 */
const defPatterns = terms.map((t) => ({
  term: t.term,
  pats: [t.term, ...(t.also ?? [])].map(termPattern),
  text: `${t.short}\n${t.detail ?? ''}`,
}));

/** term -> the other terms whose names appear in its own definition */
const names = new Map<string, Set<string>>();
for (const a of defPatterns) {
  const set = new Set<string>();
  for (const b of defPatterns) {
    if (b.term === a.term) continue;
    if (b.pats.some((re) => re.test(a.text))) set.add(b.term);
  }
  names.set(a.term, set);
}

/**
 * How much a mention is worth, by how rare it is.
 *
 * Without this, "Bit" relates to whatever definitions happen to contain the
 * English word "bit", and "Shell" attaches itself to half the glossary. A term
 * named in two definitions is specific; one named in forty is noise, and the
 * weight says so.
 */
const namedIn = new Map<string, number>();
for (const [, set] of names) {
  for (const name of set) namedIn.set(name, (namedIn.get(name) ?? 0) + 1);
}
const weightOf = (term: string) => 1 / (1 + (namedIn.get(term) ?? 0));

const related = new Map<string, string[]>();
for (const a of terms) {
  const mine = new Set(appearsIn.get(a.term) ?? []);
  const mineNames = names.get(a.term) ?? new Set<string>();

  const scored: { term: string; score: number; category: string; weak: boolean }[] = [];
  for (const b of terms) {
    if (b.term === a.term) continue;

    const theirs = appearsIn.get(b.term) ?? [];
    let shared = 0;
    for (const i of theirs) if (mine.has(i)) shared++;

    /*
     * Overlap alone favours the ubiquitous. "Shell" appears in most lessons, so
     * it shares at least two with almost every term and wins every list. What
     * is wanted is how much two terms agree relative to how much they appear at
     * all, which is the Jaccard index: shared over the union.
     */
    const union = mine.size + theirs.length - shared;
    const similarity = union > 0 ? shared / union : 0;
    // One shared lesson is a coincidence; two is a relationship.
    const lessonSignal = shared >= 2 ? similarity * 10 : 0;

    /*
     * Both pointing at the same lesson is a real link even when the words
     * themselves appear once, and it is what connects Active Directory to
     * Kerberos. It is weighted below a specific mention, because "we are both
     * taught in this lesson" is weaker than "my definition names you".
     */
    const sameLesson = Boolean(a.see) && a.see === b.see ? 1.5 : 0;

    // A mention is worth something only if the term being mentioned is specific.
    let mention = 0;
    if (mineNames.has(b.term)) mention += weightOf(b.term);
    if (names.get(b.term)?.has(a.term)) mention += weightOf(b.term);

    /*
     * A mention only counts if it is specific. weightOf is 1 for a term nobody
     * else names, 0.5 for one other definition, and falls away fast. Below a
     * third the link is just "both of these are security words", which is not
     * worth a chip.
     */
    const strongMention = mention >= 0.34 ? mention : 0;

    const score = lessonSignal + sameLesson + strongMention;
    if (score === 0) continue;
    // Weak means the only reason is "both taught in the same lesson".
    const weak = lessonSignal === 0 && strongMention === 0;
    scored.push({ term: b.term, score, category: b.category, weak });
  }

  /*
   * Score first, then subject. A tie inside one subject is far more useful than
   * a tie across two: the reader looking up Kerberos wants Active Directory,
   * not the offensive term that happens to be alphabetically earlier.
   */
  scored.sort((x, y) => {
    if (y.score !== x.score) return y.score - x.score;
    const xc = x.category === a.category ? 0 : 1;
    const yc = y.category === a.category ? 0 : 1;
    if (xc !== yc) return xc - yc;
    return x.term.localeCompare(y.term);
  });
  /*
   * At most one of the three may be a weak, same-lesson link. Without this cap
   * a term with no real relationships fills every slot with its lesson
   * neighbours, which reads as noise. Showing two good links and one filler
   * beats three fillers.
   */
  const picked: string[] = [];
  let weakUsed = 0;
  for (const s of scored) {
    if (s.weak && weakUsed >= 1) continue;
    if (s.weak) weakUsed++;
    picked.push(s.term);
    if (picked.length === 3) break;
  }
  related.set(a.term, picked);
}

/** How many lessons mention a term, which is a decent proxy for how central it is. */
const mentionCount = (term: string) => (appearsIn.get(term) ?? []).length;

// Group by initial so the A to Z bar has something to jump to.
const byLetter = new Map<string, typeof terms>();
for (const t of terms) {
  const letter = t.term.replace(/^the\s+/i, '').charAt(0).toUpperCase();
  if (!byLetter.has(letter)) byLetter.set(letter, []);
  byLetter.get(letter)!.push(t);
}
const groups = [...byLetter.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const letters = initials();

const lessonHref = (slug: string) => `${base}learn/${slug}/`;
---

<BaseLayout
  title="Glossary"
  description={`${totalTerms} cybersecurity, IT and computer science terms defined plainly, each linked to the lesson that teaches it.`}
>
  <section class="wrap gloss">
    <header class="gloss__head">
      <p class="eyebrow">Glossary</p>
      <h1>Every term this course uses, defined</h1>
      <p class="lede">
        {totalTerms} words from cybersecurity, IT and computer science. Each one gets a definition you
        can act on and, where the course covers it, a link to the lesson that teaches it properly.
      </p>
    </header>

    <div class="gloss__controls">
      <div class="gloss__search">
        <label for="gloss-q" class="visually-hidden">Search the glossary</label>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <input
          id="gloss-q"
          type="search"
          data-q
          placeholder="Search a term, an abbreviation, or a word from a definition"
          autocomplete="off"
          spellcheck="false"
        />
        <button class="gloss__clear" type="button" data-clear hidden aria-label="Clear the search">
          Clear
        </button>
      </div>

      <div class="gloss__filters" role="group" aria-label="Filter by subject">
        <button class="chip chip--on" type="button" data-gloss-cat="all" aria-pressed="true">
          All <span class="chip__n">{totalTerms}</span>
        </button>
        {categories.map((c) => (
          <button class="chip" type="button" data-gloss-cat={c.id} aria-pressed="false">
            {c.label} <span class="chip__n">{countIn(c.id)}</span>
          </button>
        ))}
      </div>

      <nav class="gloss__az" aria-label="Jump to a letter">
        {letters.map((l) => (
          <a href={`#letter-${l}`} data-az={l}>{l}</a>
        ))}
      </nav>

      <p class="gloss__count" data-count aria-live="polite">
        Showing all {totalTerms} terms
      </p>
    </div>

    <div class="gloss__body" data-body>
      {groups.map(([letter, list]) => (
        <section class="gloss__letter" data-letter={letter} id={`letter-${letter}`}>
          <h2 class="gloss__letter-head">{letter}</h2>
          <div class="gloss__grid">
            {list.map((t) => (
              <article class="term" data-term data-category={t.category} data-search={haystack(t)}>
                <h3 class="term__name">
                  {t.term}
                  {t.also && t.also.length > 0 && (
                    <span class="term__also">{t.also.join(' · ')}</span>
                  )}
                </h3>
                <p class="term__short">{t.short}</p>
                {t.detail && <p class="term__detail">{t.detail}</p>}
                <div class="term__foot">
                  {t.see && (
                    <a class="term__see" href={lessonHref(t.see)}>
                      Read the lesson
                    </a>
                  )}
                  {mentionCount(t.term) > 0 && (
                    <span class="term__count">
                      in {mentionCount(t.term)} lesson{mentionCount(t.term) === 1 ? '' : 's'}
                    </span>
                  )}
                </div>
                {(related.get(t.term) ?? []).length > 0 && (
                  <p class="term__related">
                    <span class="term__related-label">See also</span>
                    {(related.get(t.term) ?? []).map((r) => (
                      <a href={`?q=${encodeURIComponent(r)}`} data-related>{r}</a>
                    ))}
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p class="gloss__empty" data-empty hidden>
      Nothing matches that. Try a shorter word, or clear the filter.
    </p>

    <p class="gloss__foot">
      Definitions are written for this course rather than copied from a dictionary, so they say what a
      term means in the context you will meet it. If one is wrong or out of date, the repository link
      in the footer is where to say so.
    </p>
  </section>
</BaseLayout>

<script>
  function initGlossary() {
    const body = document.querySelector<HTMLElement>('[data-body]');
    if (!body || body.dataset.wired === '1') return;
    body.dataset.wired = '1';

    const q = document.querySelector<HTMLInputElement>('[data-q]');
    const clear = document.querySelector<HTMLButtonElement>('[data-clear]');
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-gloss-cat]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-term]')];
    const letters = [...document.querySelectorAll<HTMLElement>('[data-letter]')];
    const azLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-az]')];
    const countEl = document.querySelector<HTMLElement>('[data-count]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    if (!q || !countEl || !empty) return;

    let category = 'all';

    const apply = () => {
      const needle = q.value.trim().toLowerCase();
      let shown = 0;

      for (const card of cards) {
        const matchesCategory = category === 'all' || card.dataset.category === category;
        const matchesText = needle === '' || (card.dataset.search ?? '').includes(needle);
        const visible = matchesCategory && matchesText;
        card.hidden = !visible;
        if (visible) shown++;
      }

      // A letter with nothing left under it should not be a heading or a link.
      const live = new Set<string>();
      for (const section of letters) {
        const any = [...section.querySelectorAll<HTMLElement>('[data-term]')].some((c) => !c.hidden);
        section.hidden = !any;
        if (any) live.add(section.dataset.letter ?? '');
      }
      for (const a of azLinks) a.hidden = !live.has(a.dataset.az ?? '');

      countEl.textContent =
        shown === cards.length
          ? `Showing all ${cards.length} terms`
          : `Showing ${shown} of ${cards.length} terms`;
      empty.hidden = shown !== 0;
      if (clear) clear.hidden = needle === '';
    };

    q.addEventListener('input', apply);

    clear?.addEventListener('click', () => {
      q.value = '';
      q.focus();
      apply();
    });

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        category = chip.dataset.glossCat ?? 'all';
        for (const other of chips) {
          const on = other === chip;
          other.classList.toggle('chip--on', on);
          other.setAttribute('aria-pressed', String(on));
        }
        apply();
      });
    }

    // A jump link has to move the page, not just the hash, because the target
    // may have been hidden a moment ago by a filter.
    for (const a of azLinks) {
      a.addEventListener('click', (event) => {
        const target = document.querySelector<HTMLElement>(`#letter-${a.dataset.az}`);
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    // "See also" filters in place rather than navigating, so the reader keeps
    // their place in a long list.
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-related]')) {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const term = new URL(link.href, location.href).searchParams.get('q') ?? '';
        q.value = term;
        apply();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Arriving with ?q= in the URL, so a search can be linked to.
    const preset = new URLSearchParams(location.search).get('q');
    if (preset) q.value = preset;

    apply();
  }

  initGlossary();
  document.addEventListener('astro:page-load', initGlossary);
</script>
