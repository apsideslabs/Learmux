---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/practice.css';
import { allSets, questionCount, taskCount } from '../../data/practice';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const sets = allSets();
const questions = questionCount();
const tasks = taskCount();
---

<BaseLayout
  title="Test yourself"
  description={`${questions} multiple-choice questions and ${tasks} tasks where you run a real command on your own device and paste what it printed.`}
>
  <div class="wrap">
    <header class="section--tight">
      <h1>Test yourself</h1>
      <p class="lede">
        {questions} questions and {tasks} tasks, one set per lesson. The questions explain
        why the answer is right. The tasks ask you to run a real command on your own phone
        and paste what it printed, and they are marked on what the output means rather
        than on the exact characters.
      </p>
    </header>

    <div class="ctf-note">
      <strong>How the marking works</strong>
      Everything here is marked in your browser, so you are marking your own work. On a
      site with no server the answers have to be in the page, and they are. That is fine,
      because the point is the explanation, not the mark. The tasks are more useful: you
      cannot answer one without actually running the command and reading what came back.
    </div>

    <div class="practice-grid">
      {sets.map((s) => (
        <a class="practice-card" href={`${base}practice/${s.slug}/`}>
          <h3>{s.title}</h3>
          <p>{s.summary}</p>
          <div class="practice-card__meta">
            <span class="chip">{s.questions.length} question{s.questions.length === 1 ? '' : 's'}</span>
            {s.tasks.length > 0 && (
              <span class="chip chip--easy">
                {s.tasks.length} task{s.tasks.length === 1 ? '' : 's'}
              </span>
            )}
          </div>
        </a>
      ))}
    </div>

    <section>
      <h2>Where these come from</h2>
      <p>
        Each set follows a lesson and tests what that lesson actually taught, so the
        questions are answerable from the reading and the tasks use only commands the
        lesson covered. Every lesson with a set has a link to it at the foot of the page.
      </p>
      <p>
        <a class="btn" href={`${base}course/`}>The course</a>
        <a class="btn" href={`${base}ctf/`}>Or play the Termux CTF</a>
      </p>
    </section>
  </div>
</BaseLayout>
