---
import type { ChallengeMeta } from '../lib/types';

interface Props {
  challenge: ChallengeMeta;
}

const { challenge } = Astro.props;
const diffClass = { Easy: 'pill--easy', Medium: 'pill--medium', Hard: 'pill--hard' }[challenge.difficulty];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
---

<a
  class="card card--link"
  href={`${base}challenges/${challenge.slug}/`}
  data-challenge-slug={challenge.slug}
  aria-label={`${challenge.title} — ${challenge.difficulty} challenge`}
>
  <div class="challenge-head">
    <span class={`pill ${diffClass}`}>{challenge.difficulty}</span>
    <span class="pill pill--points">{challenge.points} pts</span>
    <span class="pill">{challenge.category}</span>
    <span class="pill pill--solved" data-solved-only>✔ solved</span>
  </div>
  <h3>{challenge.title}</h3>
  <p class="muted">{challenge.summary}</p>
  <div class="card-foot">
    <span class="mono">challenges/{challenge.slug}</span>
  </div>
</a>
