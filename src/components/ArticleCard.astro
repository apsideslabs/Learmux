---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'tutorials'>;
  variant?: 'default' | 'hero';
}

const { entry, variant = 'default' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const { title, category, excerpt, level } = entry.data;
const thumb = `${base}thumbs/${entry.id}.svg`;
---

<a class={`card${variant === 'hero' ? ' card--hero' : ''}`} href={`${base}learn/${entry.id}/`}>
  <div class="card__media">
    <img src={thumb} alt="" width="1200" height="675" loading="lazy" decoding="async" />
    <span class="card__cat">{category}</span>
    {variant === 'hero' && (
      <div class="card__overlay">
        <span class="card__title">{title}</span>
      </div>
    )}
  </div>
  <div class="card__body">
    {variant !== 'hero' && <span class="card__title">{title}</span>}
    <span class="card__meta">{level}</span>
    <span class="card__excerpt">{excerpt}</span>
  </div>
</a>
