---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'tutorials'>;
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const { title, category, excerpt, level } = entry.data;
const thumb = `${base}thumbs/${entry.id}.svg`;
---

<a class="post" href={`${base}learn/${entry.id}/`}>
  <span class="post__thumb">
    <img src={thumb} alt="" width="1200" height="675" loading="lazy" decoding="async" />
  </span>
  <span>
    <span class="post__title">{title}</span>
    <span class="post__meta">{category} · {level}</span>
    <span class="post__excerpt">{excerpt}</span>
  </span>
</a>
