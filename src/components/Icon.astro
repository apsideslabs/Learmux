---
/**
 * Inline SVG icon set. Simple, original glyphs drawn on a 24×24 grid.
 * Decorative by default (aria-hidden); pass a `title` for a standalone icon.
 */
interface Props {
  name: 'search' | 'chevron' | 'close' | 'user' | 'calendar' | 'github' | 'arrow' | 'info' | 'warning' | 'tip' | 'copy' | 'check' | 'grid' | 'key' | 'hash' | 'lock' | 'network' | 'shield' | 'swap';
  size?: number;
  title?: string;
}
const { name, size = 20, title } = Astro.props;
const dim = { width: size, height: size, viewBox: '0 0 24 24', fill: 'none', xmlns: 'http://www.w3.org/2000/svg' } as const;
---

<svg {...dim} aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined}>
  {title && <title>{title}</title>}
  {name === 'copy' && (<><rect x="8.6" y="8.6" width="11" height="11.4" rx="2.2" stroke="currentColor" stroke-width="1.7" /><path d="M15.4 5.8A2.2 2.2 0 0 0 13.2 3.6H6.2A2.2 2.2 0 0 0 4 5.8v7a2.2 2.2 0 0 0 2.2 2.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></>)}
  {name === 'check' && (<path d="M4.8 12.6l4.8 4.8L19.2 6.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />)}
  {name === 'grid' && (<><rect x="3.6" y="3.6" width="7.2" height="7.2" rx="1.6" stroke="currentColor" stroke-width="1.7" /><rect x="13.2" y="3.6" width="7.2" height="7.2" rx="1.6" stroke="currentColor" stroke-width="1.7" /><rect x="3.6" y="13.2" width="7.2" height="7.2" rx="1.6" stroke="currentColor" stroke-width="1.7" /><rect x="13.2" y="13.2" width="7.2" height="7.2" rx="1.6" stroke="currentColor" stroke-width="1.7" /></>)}
  {name === 'search' && (<><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8" /><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></>)}
  {name === 'chevron' && (<path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />)}
  {name === 'arrow' && (<path d="M5 12h13m-5-6l6 6-6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />)}
  {name === 'close' && (<path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />)}
  {name === 'user' && (<><circle cx="12" cy="8.5" r="3.6" stroke="currentColor" stroke-width="1.7" /><path d="M4.8 19.5c1.4-3.1 4.1-4.6 7.2-4.6s5.8 1.5 7.2 4.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></>)}
  {name === 'calendar' && (<><rect x="3.8" y="5.2" width="16.4" height="14.6" rx="2.4" stroke="currentColor" stroke-width="1.7" /><path d="M3.8 9.6h16.4M8.4 3.6v3.2M15.6 3.6v3.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></>)}
  {name === 'github' && (<path d="M9.2 19.2c-3.5 1-3.5-1.8-4.9-2.2m9.8 4.4v-3.3c0-.9.1-1.3-.4-1.8 2.2-.3 4.5-1.1 4.5-5 0-1.1-.4-2-1-2.7.1-.3.4-1.3-.1-2.7 0 0-.8-.3-2.7 1a9.3 9.3 0 0 0-4.8 0c-1.9-1.3-2.7-1-2.7-1-.5 1.4-.2 2.4-.1 2.7a3.9 3.9 0 0 0-1 2.7c0 3.9 2.3 4.7 4.5 5-.3.3-.6.8-.6 1.5v3.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />)}
  {name === 'info' && (<><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7" /><path d="M12 11v5.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><circle cx="12" cy="7.9" r="1.05" fill="currentColor" /></>)}
  {name === 'warning' && (<><path d="M12 4.6l7.6 13.2H4.4L12 4.6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /><path d="M12 10v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><circle cx="12" cy="16.4" r="1.05" fill="currentColor" /></>)}
  {name === 'tip' && (<><path d="M9.2 17.6h5.6M10 20.4h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path d="M12 3.6a5.6 5.6 0 0 0-3.3 10.1c.5.4.8 1 .8 1.6h5a2.4 2.4 0 0 1 .8-1.6A5.6 5.6 0 0 0 12 3.6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></>)}
  {name === 'key' && (<><circle cx="8.2" cy="8.4" r="4.2" stroke="currentColor" stroke-width="1.7" /><path d="M11.2 11.4l8 8M16.6 16.8l2-2M14.2 14.4l1.6-1.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></>)}
  {name === 'hash' && (<path d="M9.4 4.4l-1.8 15.2M16.4 4.4l-1.8 15.2M4.6 9h14.8M3.8 15h14.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />)}
  {name === 'lock' && (<><rect x="4.6" y="10.4" width="14.8" height="9.6" rx="2.2" stroke="currentColor" stroke-width="1.7" /><path d="M8.2 10.4V7.8a3.8 3.8 0 0 1 7.6 0v2.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><circle cx="12" cy="15.2" r="1.15" fill="currentColor" /></>)}
  {name === 'network' && (<><circle cx="12" cy="5.2" r="2.4" stroke="currentColor" stroke-width="1.7" /><circle cx="5.2" cy="18.2" r="2.4" stroke="currentColor" stroke-width="1.7" /><circle cx="18.8" cy="18.2" r="2.4" stroke="currentColor" stroke-width="1.7" /><path d="M12 7.6v4.2M12 11.8L6.6 16.2M12 11.8l5.4 4.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></>)}
  {name === 'shield' && (<path d="M12 3.8l6.8 2.6v5.4c0 3.9-2.7 6.9-6.8 8.4-4.1-1.5-6.8-4.5-6.8-8.4V6.4L12 3.8z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />)}
  {name === 'swap' && (<path d="M5 8.4h11.4m-3-3l3 3-3 3M19 15.6H7.6m3 3l-3-3 3-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />)}
</svg>
