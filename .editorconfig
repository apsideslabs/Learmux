# Keep editors agreeing on the basics, so a diff is about content and not
# whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{astro,css}]
indent_size = 2

[*.mdx]
indent_size = 2
